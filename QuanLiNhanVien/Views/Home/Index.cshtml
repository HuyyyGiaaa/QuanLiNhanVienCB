@{
    ViewData["Title"] = "Trang Chủ - Quản Lý Nhân Sự";
}

<style>
    /* Tổng thể */
    body {
        background-color: #f8f9fa;
        font-family: 'Inter', sans-serif;
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white !important;
        border-radius: 20px;
        padding: 4rem 2rem;
        margin-bottom: 3rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .hero-section h1 {
        font-weight: 800;
        letter-spacing: -1px;
    }

    /* Card Styling */
    .custom-card {
        border: none;
        border-radius: 15px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .custom-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
    }

    .icon-box {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 1.5rem;
        font-size: 1.8rem;
    }

    /* Table Styling */
    .table-container {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .table thead th {
        background-color: #4e73df;
        color: white;
        border: none;
        padding: 15px;
    }

    .table tbody tr:hover {
        background-color: #f1f4ff;
    }

    /* Badge & Button */
    .btn-custom {
        border-radius: 10px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .section-title {
        position: relative;
        padding-left: 15px;
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    .section-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 5px;
        height: 70%;
        width: 5px;
        border-radius: 10px;
    }

    .title-blue::before { background-color: #0d6efd; }
    .title-orange::before { background-color: #ffc107; }
    .title-green::before { background-color: #198754; }
</style>

<div class="container mt-5">
    <div class="hero-section text-center shadow-lg">
        <h1 class="display-4">Hệ Thống Quản Lý Nhân Sự</h1>
        <p class="fs-5 opacity-75">Chào mừng bạn quay trở lại. Hãy quản lý đội ngũ của bạn một cách hiệu quả nhất!</p>
        
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-light d-inline-block mt-3 animate__animated animate__fadeInUp" role="alert" style="border-radius: 50px; color: #121212; font-weight: bold;">
                <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.Message
            </div>
        }
    </div>


    @if (ViewBag.Employees != null && ViewBag.Employees.Count > 0)
    {
        <div class="mb-5 animate__animated animate__fadeIn">
            <h3 class="section-title title-blue text-primary">Danh Sách Nhân Viên</h3>
            <div class="table-container">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Họ và Tên</th>
                                <th>Giới Tính</th>
                                <th>Ngày Sinh</th>
                                <th>Email</th>
                                <th>Số Điện Thoại</th>
                                <th>Ngày Tuyển</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in ViewBag.Employees)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark">#@emp.EmpId</span></td>
                                    <td><strong>@emp.FullName</strong></td>
                                    <td>@emp.Gender</td>
                                    <td>@emp.BirthDate?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-primary">@emp.Email</td>
                                    <td>@emp.Phone</td>
                                    <td><span class="text-muted small">@emp.HireDate?.ToString("dd/MM/yyyy")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    @if (ViewBag.Positions != null && ViewBag.Positions.Count > 0)
    {
        <div class="mb-5">
            <h3 class="section-title title-green text-success">Danh Sách Chức Vụ</h3>
            <div class="table-container">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="table-dark">
                                <th>ID</th>
                                <th>Chức Vụ</th>
                                <th class="text-end">Lương Cơ Bản</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pos in ViewBag.Positions)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark">@pos.PositionId</span></td>
                                    <td><strong class="text-success">@pos.PositionTitle</strong></td>
                                    <td class="text-end fw-bold">@pos.BaseSalary.ToString("N0") <span class="small text-muted">VND</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (ViewBag.Departments != null && ViewBag.Departments.Count > 0)
{
    <div class="mb-5">
        <h3 class="section-title title-orange text-warning">Danh Sách Phòng Ban</h3>
        <div class="row g-4">
            @foreach (var dept in ViewBag.Departments)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 custom-card border-start border-warning border-4 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-warning fw-bold">@dept.DeptName</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i> @dept.Location</span>
                                <span class="badge bg-warning bg-opacity-10 text-warning px-3">ID: @dept.DeptId</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}